# Copy this file to .env.local and fill in the values from
# Supabase: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by the seed script on your computer. Never add this to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The two people allowed to sign in (used by the seed script)
PATRICE_EMAIL=patrice@example.com
AJ_EMAIL=aj@example.com
